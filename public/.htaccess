# ----------------------------------------------------------------------
# NK Associates Global - Apache / LiteSpeed Configuration (.htaccess)
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirect HTTP to HTTPS (301 Permanent)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirect WWW to Non-WWW (Canonical: https://nkassociatesglobal.com)
  RewriteCond %{HTTP_HOST} ^www\.nkassociatesglobal\.com$ [NC]
  RewriteRule ^(.*)$ https://nkassociatesglobal.com/$1 [L,R=301]

  # 3. React Single Page Application (SPA) Fallback
  # If the requested path is not an existing physical file or directory, serve index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# 4. MIME Types Configuration
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/xml .xml
  AddType application/xml .xml
  AddType application/json .json
  AddType application/ld+json .jsonld
  AddType image/png .png
  AddType image/svg+xml .svg .svgz
</IfModule>

# 5. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
